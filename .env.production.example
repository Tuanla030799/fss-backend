# Legacy VM deployment (docker-compose.prod.yml). Placeholders only.
SPRING_PROFILES_ACTIVE=docker
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/fss?retryWrites=true&w=majority&maxPoolSize=10

APP_JWT_SECRET=replace-with-a-long-random-secret-of-at-least-64-characters
APP_JWT_ACCESS_TOKEN_MINUTES=30
APP_JWT_REFRESH_TOKEN_DAYS=30

STORAGE_PROVIDER=local
APP_UPLOAD_DIR=/app/uploads
APP_CDN_BASE_URL=https://thepocketshoes.store/files
APP_CORS_ALLOWED_ORIGINS=https://thepocketshoes.store,https://www.thepocketshoes.store
APP_AUTH_ALLOW_PUBLIC_ADMIN_REGISTRATION=false

# Kept only so scripts/backup-prod.sh can still dump the legacy PostgreSQL database.
POSTGRES_DB=fss
POSTGRES_USER=fss_app
POSTGRES_PASSWORD=change-this-strong-database-password

LOGGING_FILE_PATH=/app/logs
BACKEND_PUBLIC_NETWORK=thepocketshoes_net
TZ=Asia/Ho_Chi_Minh
