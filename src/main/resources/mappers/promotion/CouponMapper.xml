<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fss.backend.promotion.coupon.CouponMapper">
    <select id="findCouponByCode" resultType="com.fss.backend.promotion.coupon.Coupon">SELECT * FROM coupons WHERE UPPER(code)=UPPER(#{code}) AND deleted_at IS NULL</select>
    <select id="findCouponById" resultType="com.fss.backend.promotion.coupon.Coupon">SELECT * FROM coupons WHERE id=#{id} AND deleted_at IS NULL</select>
    <select id="listCoupons" resultType="com.fss.backend.promotion.coupon.Coupon">SELECT * FROM coupons <where>deleted_at IS NULL <if test="status != null and status != ''">AND status=#{status}</if><if test="keyword != null and keyword != ''">AND (code ILIKE CONCAT('%',#{keyword},'%') OR name ILIKE CONCAT('%',#{keyword},'%'))</if></where> ORDER BY created_at DESC LIMIT #{limit} OFFSET #{offset}</select>
    <insert id="insertCoupon">INSERT INTO coupons(id,code,name,discount_type,discount_value,max_discount,min_order_amount,usage_limit,starts_at,ends_at,status,created_by,updated_by) VALUES(#{id},UPPER(#{code}),#{name},#{discountType},#{discountValue},#{maxDiscount},#{minOrderAmount},#{usageLimit},#{startsAt},#{endsAt},#{status},#{adminId},#{adminId})</insert>
    <update id="updateCoupon">UPDATE coupons SET code=UPPER(#{code}),name=#{name},discount_type=#{discountType},discount_value=#{discountValue},max_discount=#{maxDiscount},min_order_amount=#{minOrderAmount},usage_limit=#{usageLimit},starts_at=#{startsAt},ends_at=#{endsAt},status=#{status},updated_by=#{adminId} WHERE id=#{id}</update>
    <update id="incrementCouponUsed">UPDATE coupons SET used_count=used_count+1 WHERE id=#{id}</update>
    <update id="softDeleteCoupon">UPDATE coupons SET deleted_at=now(), updated_by=#{adminId} WHERE id=#{id}</update>
</mapper>
