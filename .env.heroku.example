# Heroku Config Vars (heroku config:set KEY=value). Placeholders only - never commit real values.
SPRING_PROFILES_ACTIVE=heroku

# MongoDB Atlas (replica set; transactions required). URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/fss?retryWrites=true&w=majority&maxPoolSize=10
MONGODB_DATABASE=fss

# Security
APP_JWT_SECRET=<random-64+-characters, e.g. openssl rand -base64 64>
APP_JWT_ACCESS_TOKEN_MINUTES=30
APP_JWT_REFRESH_TOKEN_DAYS=30
APP_CORS_ALLOWED_ORIGINS=https://<frontend-domain>,https://www.<frontend-domain>
# Optional: only used when the database has no admin yet (fresh database, no migration).
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Cloudflare R2 (S3-compatible API)
STORAGE_PROVIDER=r2
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket-name>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Public custom domain (or r2.dev URL) of the bucket, without trailing slash. Files are served at <base>/files/<path>.
R2_PUBLIC_BASE_URL=https://<images-domain>
# Old hosts whose /files/... images appear in existing HTML content (comma separated).
APP_CONTENT_ALLOWED_IMAGE_HOSTS=<old-frontend-domain>,www.<old-frontend-domain>

# Optional tuning
JVM_MAX_HEAP=256m
APP_IMAGE_MAX_CONCURRENT=2
APP_FILE_CLEANUP_INACTIVE_TTL=PT24H
